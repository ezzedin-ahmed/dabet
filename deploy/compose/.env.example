# Copy to .env next to docker-compose.yml. These are local-dev defaults and
# every one of them is already the compose default — the file only exists so
# you can change one without editing the compose file.

# Compose infrastructure credentials
POSTGRES_USER=dabet
POSTGRES_PASSWORD=dabet
POSTGRES_DB=dabet
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Both ClickHouse credentials must be set: the official image's entrypoint
# disables network access for `default` when neither CLICKHOUSE_USER nor
# CLICKHOUSE_PASSWORD is present, and /ping answers without auth, so the
# container reports healthy while every client is rejected.
CLICKHOUSE_USER=dabet
CLICKHOUSE_PASSWORD=dabet
CLICKHOUSE_DB=dabet

# Third-party stubs (tools/). Real keys are never needed locally.
STRIPE_SECRET_KEY=sk_test_local
STRIPE_WEBHOOK_SECRET=whsec_local_dev

# Canonical service configuration (docs §4.4) for services run ON THE HOST
# against this compose stack. Inside compose, services use the service names
# instead (see the x-infra-env anchor in docker-compose.yml).
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
POSTGRES_DSN=postgres://dabet:dabet@localhost:5432/dabet?sslmode=disable
MEMCACHED_ADDRS=localhost:11211
VLLM_ENDPOINT=http://localhost:8089
EMBEDDING_ENDPOINT=http://localhost:8091
MILVUS_ADDR=localhost:19530
CLICKHOUSE_DSN=clickhouse://dabet:dabet@localhost:9002/dabet
S3_ENDPOINT=http://localhost:9000
JWT_SECRET=dev-secret-change-me

# Live centroid assignment (§8.5) is opt-in: empty disables the hop rather
# than counting a fail-open against a service that was never deployed.
# `make up-full` sets it to http://clustering-service:8080.
CLUSTERING_ENDPOINT=

# Per-service listen addresses (override per process; many services share a host)
HTTP_ADDR=:8080
METRICS_ADDR=:9090
