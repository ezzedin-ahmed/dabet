# Copy to .env next to docker-compose.yml. These are local-dev defaults.

# Compose infrastructure credentials
POSTGRES_USER=dabet
POSTGRES_PASSWORD=dabet
POSTGRES_DB=dabet
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Canonical service configuration (docs §4.4) for services run on the host
# against this compose stack. Prefixed by concern, not by service.
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
POSTGRES_DSN=postgres://dabet:dabet@localhost:5432/dabet?sslmode=disable
MEMCACHED_ADDRS=localhost:11211
VLLM_ENDPOINT=http://localhost:8089
EMBEDDING_ENDPOINT=http://localhost:8091
MILVUS_ADDR=localhost:19530
CLICKHOUSE_DSN=clickhouse://localhost:9002/dabet
S3_ENDPOINT=http://localhost:9000
JWT_SECRET=dev-secret-change-me

# Per-service listen addresses (override per process; many services share a host)
HTTP_ADDR=:8080
METRICS_ADDR=:9090
